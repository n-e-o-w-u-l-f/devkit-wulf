      "amd64": "amd64",
      "arm64": "arm64"
    },
    "kind": "archive",
    "archive_format": "zip",
    "filename_pattern": "^go[0-9]+\\.[0-9]+(\\.[0-9]+)?\\.windows-(amd64|arm64)\\.zip$",
    "root_directory": "go",
    "destination_template": "{localappdata}/devkit-wulf/go",
    "path_directory_template": "{localappdata}/devkit-wulf/go/bin",
    "marker_relative_path": ".devkit-wulf-artifact.json",
    "critical_files": ["bin/go.exe", "bin/gofmt.exe"],
    "integrity": "sha256-release-metadata",
    "privileged": false,
    "path_mutation": false
  }
