{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/n-e-o-w-u-l-f/devkit-wulf/manifests/schema/composer-windows.schema.json",
  "title": "devkit-wulf Composer Windows PHAR contract",
  "type": "object",
  "required": ["schema_version", "research_date", "publisher", "phar_url", "checksum_url", "version_pattern", "target"],
  "properties": {
    "schema_version": {"const": 1},
    "research_date": {"type": "string", "format": "date"},
    "publisher": {"const": "Composer"},
    "phar_url": {"const": "https://getcomposer.org/download/latest-stable/composer.phar"},
    "checksum_url": {"const": "https://getcomposer.org/download/latest-stable/composer.phar.sha256sum"},
    "version_pattern": {"type": "string", "minLength": 8},
    "target": {
      "type": "object",
      "required": ["platform", "architecture", "php_directory_template", "php_executable", "php_marker", "phar_name", "wrapper_name", "marker_name", "integrity", "privileged", "path_mutation"],
      "properties": {
        "platform": {"const": "windows"},
        "architecture": {"const": "amd64"},
        "php_directory_template": {"const": "{localappdata}\\devkit-wulf\\php"},
        "php_executable": {"const": "php.exe"},
        "php_marker": {"const": ".devkit-wulf-artifact.json"},
        "phar_name": {"const": "composer.phar"},
        "wrapper_name": {"const": "composer.bat"},
        "marker_name": {"const": ".devkit-wulf-composer.json"},
        "integrity": {"const": "sha256-double-read"},
        "privileged": {"const": false},
        "path_mutation": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
