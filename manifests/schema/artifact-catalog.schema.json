{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/n-e-o-w-u-l-f/devkit-wulf/manifests/schema/artifact-catalog.schema.json",
  "title": "devkit-wulf verified artifact catalog",
  "type": "object",
  "required": ["schema_version", "research_date", "artifacts"],
  "properties": {
    "schema_version": {"const": 2},
    "research_date": {"type": "string", "format": "date"},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "textVersionResolver": {
      "type": "object",
      "required": ["resolver", "url", "pattern"],
      "properties": {
        "resolver": {"const": "text-url"},
        "url": {"type": "string", "pattern": "^https://"},
        "pattern": {"type": "string", "minLength": 3}
      },
      "additionalProperties": false
    },
    "releaseIndexResolver": {
      "type": "object",
      "required": ["resolver", "channel", "version_pattern"],
      "properties": {
        "resolver": {"const": "release-index"},
        "channel": {"type": "string", "enum": ["stable", "beta", "dev"]},
        "version_pattern": {"type": "string", "minLength": 3}
      },
      "additionalProperties": false
    },
    "binaryArchitecture": {
      "type": "object",
      "required": ["filename", "url_template", "checksum_url_template"],
      "properties": {
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9._+-]+$"},
        "url_template": {"type": "string", "pattern": "^https://.*\\{version\\}"},
        "checksum_url_template": {"type": "string", "pattern": "^https://.*\\{version\\}"}
      },
      "additionalProperties": false
    },
    "archiveArchitecture": {
      "type": "object",
      "required": ["release_arch"],
      "properties": {
        "release_arch": {"type": "string", "enum": ["x64", "arm64"]}
      },
      "additionalProperties": false
    },
    "binaryTarget": {
      "type": "object",
      "required": ["kind", "destination", "path_directory", "mode", "integrity", "privileged", "architectures"],
      "properties": {
        "kind": {"const": "binary"},
        "destination": {"type": "string", "pattern": "^/"},
        "path_directory": {"type": "string", "pattern": "^/"},
        "mode": {"type": "string", "pattern": "^0[0-7]{3}$"},
        "integrity": {"const": "sha256"},
        "privileged": {"type": "boolean"},
        "architectures": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/binaryArchitecture"}
        }
      },
      "additionalProperties": false
    },
    "archiveTarget": {
      "type": "object",
      "required": ["kind", "release_index_url", "expected_base_url", "destination_template", "path_directory_template", "archive_format", "root_directory", "integrity", "privileged", "architectures"],
      "properties": {
        "kind": {"const": "archive"},
        "release_index_url": {"type": "string", "pattern": "^https://"},
        "expected_base_url": {"type": "string", "pattern": "^https://"},
        "destination_template": {"type": "string", "pattern": "^\\{home\\}/"},
        "path_directory_template": {"type": "string", "pattern": "^\\{home\\}/"},
        "archive_format": {"type": "string", "enum": ["tar.xz", "zip"]},
        "root_directory": {"type": "string", "pattern": "^[A-Za-z0-9._+-]+$"},
        "integrity": {"const": "sha256-release-metadata"},
        "privileged": {"const": false},
        "architectures": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/archiveArchitecture"}
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["publisher", "source", "version", "targets"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "source": {"type": "string", "pattern": "^https://"},
        "version": {
          "oneOf": [
            {"$ref": "#/$defs/textVersionResolver"},
            {"$ref": "#/$defs/releaseIndexResolver"}
          ]
        },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {"$ref": "#/$defs/binaryTarget"},
              {"$ref": "#/$defs/archiveTarget"}
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
