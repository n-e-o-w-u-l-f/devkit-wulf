{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/n-e-o-w-u-l-f/devkit-wulf/environments/schema/python-version.schema.json",
  "title": "devkit-wulf version-specific Python environment contract",
  "type": "object",
  "required": [
    "schema_version",
    "environment",
    "version_family",
    "research_date",
    "lifecycle",
    "components",
    "policy",
    "verification",
    "adapters",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "environment": {"const": "python"},
    "version_family": {"type": "string", "pattern": "^3\\.[0-9]+$"},
    "research_date": {"type": "string", "format": "date"},
    "lifecycle": {
      "type": "object",
      "required": [
        "status",
        "upstream_latest_at_research",
        "minimum_upstream_security_patch",
        "source_only_security_releases",
        "last_classic_binary_installer_release",
        "end_of_security_support"
      ],
      "properties": {
        "status": {"enum": ["bugfix", "security"]},
        "upstream_latest_at_research": {"type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+$"},
        "minimum_upstream_security_patch": {"type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+$"},
        "source_only_security_releases": {"type": "boolean"},
        "last_classic_binary_installer_release": {"type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+$"},
        "end_of_security_support": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"}
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "policy": {
      "type": "object",
      "required": [
        "replace_system_python",
        "modify_global_python_aliases",
        "install_global_pip_packages",
        "project_virtual_environment_required",
        "exact_major_minor_required",
        "distro_security_backports_allowed"
      ],
      "properties": {
        "replace_system_python": {"const": false},
        "modify_global_python_aliases": {"const": false},
        "install_global_pip_packages": {"const": false},
        "project_virtual_environment_required": {"const": true},
        "exact_major_minor_required": {"const": true},
        "distro_security_backports_allowed": {"const": true}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "major",
        "minor",
        "runtime_command_must_be_adapter_owned_or_package_managed",
        "venv_smoke_test",
        "pip_smoke_test_inside_venv"
      ],
      "properties": {
        "major": {"const": 3},
        "minor": {"type": "integer", "minimum": 0},
        "runtime_command_must_be_adapter_owned_or_package_managed": {"const": true},
        "venv_smoke_test": {"const": true},
        "pip_smoke_test_inside_venv": {"const": true}
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/activeAdapter"},
          {"$ref": "#/$defs/unsupportedAdapter"}
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^https://"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "activeAdapter": {
      "type": "object",
      "required": ["support", "strategy", "entrypoint"],
      "properties": {
        "support": {"const": "experimental"},
        "strategy": {"enum": ["python-install-manager", "apt", "homebrew-formula"]},
        "runtime_tag": {"type": "string", "pattern": "^3\\.[0-9]+$"},
        "requires": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "minimum_runtime_patch": {"type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+$"},
        "platform_id": {"type": "string"},
        "version_id": {"type": "string"},
        "packages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "version_policy": {"enum": ["distribution-security-backports"]},
        "formula": {"type": "string"},
        "entrypoint": {"type": "string", "pattern": "^installers/(windows|linux|wsl|macos)/environments/python-3\\.[0-9]+\\.(ps1|sh)$"}
      },
      "additionalProperties": false
    },
    "unsupportedAdapter": {
      "type": "object",
      "required": ["support", "strategy", "reason"],
      "properties": {
        "support": {"const": "unsupported"},
        "strategy": {"const": "unsupported"},
        "reason": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    }
  }
}
