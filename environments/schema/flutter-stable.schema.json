{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/n-e-o-w-u-l-f/devkit-wulf/environments/schema/flutter-stable.schema.json",
  "title": "devkit-wulf Flutter stable system-native contract",
  "type": "object",
  "required": ["schema_version", "environment", "selector", "research_date", "policy", "adapters"],
  "properties": {
    "schema_version": {"const": 1},
    "environment": {"const": "flutter"},
    "selector": {"const": "flutter@stable"},
    "research_date": {"type": "string", "format": "date"},
    "policy": {
      "type": "object",
      "required": ["support", "no_path_mutation", "no_privilege", "automatic_upgrade", "wsl_inheritance"],
      "properties": {
        "support": {"const": "experimental"},
        "no_path_mutation": {"const": true},
        "no_privilege": {"const": true},
        "automatic_upgrade": {"const": false},
        "wsl_inheritance": {"const": false}
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "required": ["windows-native", "linux-native", "macos-native", "wsl2-linux", "bsd-native", "solaris-illumos-native", "aix-native"],
      "properties": {
        "windows-native": {"$ref": "#/$defs/windowsActive"},
        "linux-native": {"$ref": "#/$defs/posixActive"},
        "macos-native": {"$ref": "#/$defs/posixActive"},
        "wsl2-linux": {"$ref": "#/$defs/unsupported"},
        "bsd-native": {"$ref": "#/$defs/unsupported"},
        "solaris-illumos-native": {"$ref": "#/$defs/unsupported"},
        "aix-native": {"$ref": "#/$defs/unsupported"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "windowsActive": {
      "type": "object",
      "required": ["support", "strategy", "architectures", "artifact_manifest", "helper", "entrypoint"],
      "properties": {
        "support": {"const": "experimental"},
        "strategy": {"const": "verified-powershell-artifact"},
        "architectures": {"const": ["amd64"]},
        "artifact_manifest": {"const": "manifests/flutter-windows.json"},
        "helper": {"const": "lib/flutter-windows.ps1"},
        "entrypoint": {"const": "installers/windows/environments/flutter-stable.ps1"}
      },
      "additionalProperties": false
    },
    "posixActive": {
      "type": "object",
      "required": ["support", "strategy", "architectures", "artifact_manifest", "artifact_id", "helper", "environment_helper", "entrypoint"],
      "properties": {
        "support": {"const": "experimental"},
        "strategy": {"const": "verified-posix-artifact"},
        "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["amd64", "arm64"]}},
        "artifact_manifest": {"const": "manifests/artifacts.json"},
        "artifact_id": {"const": "flutter"},
        "helper": {"const": "lib/artifacts.sh"},
        "environment_helper": {"const": "lib/flutter-posix-environment.sh"},
        "entrypoint": {"type": "string", "pattern": "^installers/(linux|macos)/environments/flutter-stable\\.sh$"}
      },
      "additionalProperties": false
    },
    "unsupported": {
      "type": "object",
      "required": ["support", "strategy", "reason"],
      "properties": {
        "support": {"const": "unsupported"},
        "strategy": {"const": "unsupported"},
        "reason": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    }
  }
}
